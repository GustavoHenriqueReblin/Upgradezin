# Servidor
PORT=8787
HOST=127.0.0.1

# Lojas: só para a primeira vez. Ao subir, o servidor copia estas variáveis para o banco e, dali
# em diante, a configuração das lojas é editada no admin (/admin, aba Lojas); mudar aqui não vale mais.
# O código só conhece os IDs s1, s2 e s3. Todas são lidas do mesmo jeito (Chrome + extensão);
# o que muda é como o HTML de cada uma é interpretado:
#   s1  catálogo Next.js em __NEXT_DATA__
#   s2  Next.js App Router (payload RSC)
#   s3  HTML com cards data-tss-*
# NAME    nome exibido na tela
# URL     origem do site, sem barra no fim
# SEARCH  caminho da busca, com um marcador: {q} (fonte%20750W), {q+} (fonte+750W) ou {slug} (fonte-750w)
# CATEGORIES  caminho da categoria na loja, por categoria do app (opcional)
# COLOR   cor da loja na tela, "#rrggbb" entre aspas (sem aspas, o # vira comentário) (opcional).
#         Duas ou três cores separadas por vírgula viram degradê na bolinha: "#ffc300,#e30613"
# SWEEP   página de cada categoria no site, começando com /, lida pela rotina de preços (mais de uma: separadas por espaço).
#         A rotina lê a categoria inteira, algumas páginas por hora, para todo produto ter histórico.
#         Confira com: pnpm scan --sweep
# Loja sem NAME, URL ou SEARCH fica desligada.
STORE_S1_NAME=Loja 1
STORE_S1_URL=https://www.loja1.example
STORE_S1_SEARCH=/busca/{slug}
STORE_S1_COLOR="#10b981"
STORE_S1_SWEEP=psu:/hardware/fontes,motherboard:/hardware/placas-mae,cpu:/hardware/processadores,gpu:/hardware/placa-de-video,ram:/hardware/memoria-ram,ssd:/hardware/ssd,cooler:/hardware/coolers,case:/perifericos/gabinetes
STORE_S1_CATEGORIES=psu:hardware/fontes,motherboard:hardware/placas-mae,cpu:hardware/processadores,gpu:hardware/placa de video (vga)/placa de video,ram:hardware/memoria ram,ssd:hardware/ssd,cooler:hardware/coolers,case:perifericos/gabinetes

STORE_S2_NAME=Loja 2
STORE_S2_URL=https://www.loja2.example
STORE_S2_SEARCH=/search?q={q}
STORE_S2_COLOR="#8b5cf6"
STORE_S2_CATEGORIES=psu:hardware/fonte,motherboard:hardware/placa-mae,cpu:hardware/processadores

STORE_S3_NAME=Loja 3
STORE_S3_URL=https://www.loja3.example
STORE_S3_SEARCH=/busca?str={q+}
STORE_S3_COLOR="#f59e0b"
# Chrome das lojas: um Chrome comum por loja (perfil fixo em data/chrome/<loja>), sem porta de
# depuração. A extensão em apps/server/extension abre cada página numa aba, lê o HTML e fecha a aba.
# Chrome comum: instale a extensão uma vez por loja com "pnpm chrome-setup".
# Chromium ou Chrome for Testing: a extensão carrega sozinha. Em Linux sem tela, use xvfb-run.
# Vazio = Google Chrome no lugar padrão (Windows: Program Files; Linux: /usr/bin/google-chrome).
# CHROME_PATH=
# Porta local (só 127.0.0.1) entre o app e a extensão. Não passa pelo túnel.
EXT_PORT=8788
# Janela do Chrome fora da área visível (o usuário não vê). false = mostra a janela.
BROWSER_HIDE_WINDOW=true
# Espera (ms) a cada passo no Chrome (abrir aba, abrir página, ler, fechar), com o passo no terminal. 0 = sem espera.
BROWSER_STEP_MS=0
# Segundos esperando alguém resolver uma verificação interativa na janela do Chrome
# NA MÁQUINA DO SERVIDOR (o usuário final não vê essa janela). 0 = não espera.
MANUAL_CHALLENGE_WAIT_S=0

# Coleta
PAGE_DELAY_MIN_MS=5000
PAGE_DELAY_MAX_MS=12000
MAX_PAGES_PER_HOUR=30
MAX_PAGES_S1=1
MAX_PAGES_S2=3
# Busca do site: páginas por termo (a rotina e a varredura leem as seguintes; a busca mostra o que o banco já tem).
SEARCH_MAX_PAGES=1

# Pasta de dados locais: banco de preços e debug (padrão: ./data na raiz).
# DATA_DIR=

# Banco SQLite: anúncios, histórico de preço e montagens compartilhadas (padrão: <DATA_DIR>/upgradezin.db).
# DB_PATH=

# Admin em /admin (usuário e senha fixos). Sem os dois, ou com senha de menos de 10 caracteres, fica desligado.
# ADMIN_USER=
# ADMIN_PASSWORD=
# Duração da sessão (horas); reiniciar o servidor também desloga
ADMIN_SESSION_H=12

# Salva HTML + screenshot de falhas em data/debug/ para consertar adapters, e a página inteira de cada ficha técnica que vem sem medida (conferir se faltou no anúncio ou no leitor).
DEBUG_DUMPS=false

# Busca por texto ("Não achou? Buscar nas lojas"): o mesmo texto só vai de novo à mesma loja depois disto (minutos)
REVALIDATE_MIN=10
# Rotina de preços: lê a página de cada categoria nas lojas (STORE_Sx_SWEEP / admin, Lojas), só o que está em estoque.
# ROUTINE_PAGES_PER_HOUR sai do total MAX_PAGES_PER_HOUR.
# ROUTINE_ENABLED e ROUTINE_STORES valem até a rotina ser mudada no admin (aba Coleta); depois, vale o que foi salvo lá.
ROUTINE_ENABLED=true
# Lojas que a rotina lê sozinha. Bloqueio pausa a loja (15 min, 1 h, 6 h, 24 h) e depois ela tenta de novo.
ROUTINE_STORES=s1,s2,s3
# Lojas que começam no modo lento até o admin escolher (as de navegador).
ROUTINE_SLOW_STORES=s2,s3
# Modos (escolhidos por loja no admin, aba Coleta): segundos entre uma categoria e a próxima (+ até 20% aleatório);
# as páginas de uma mesma categoria seguem uma atrás da outra, com o PAGE_DELAY_* de sempre.
# Os segundos de cada modo se mudam no admin (aba Coleta), e o que está lá vale no lugar destes.
ROUTINE_NORMAL_GAP_S=15
ROUTINE_REDUCED_GAP_S=20
ROUTINE_SLOW_GAP_S=60
# A rotina lê uma categoria de novo quando a última volta completa por ela passou disto (horas)
ROUTINE_REFRESH_H=12
# Teto de páginas por caminho de categoria numa volta (a lista acaba antes, na primeira página sem nada em estoque)
ROUTINE_SWEEP_MAX_PAGES=40
ROUTINE_PAGES_PER_HOUR=12
# Categoria cuja página falhou (fora bloqueio) espera isto (minutos) antes de tentar de novo
ROUTINE_RETRY_MIN=60

# Proteções quando o app fica acessível de fora (por pessoa/IP; contadores em memória)
RATE_LIMIT_PER_MIN=120
FORCE_PER_HOUR=10
FORCE_MIN_AGE_MIN=10
SHARE_PER_HOUR=20
# Rotina de fichas (separada da coleta): uma página de produto do catálogo (todas as categorias) por loja
# a cada SHEET_ROUTINE_SECONDS segundos (uma vez por página). Valores iniciais: depois vale o admin (aba Fichas).
SHEET_ROUTINE_ENABLED=false
SHEET_ROUTINE_SECONDS=180
# Varredura completa automática de madrugada (todas as lojas e categorias, esgotados também), antes do
# backup do cron (04:30). Pausa as rotinas de preços e de fichas e volta cada uma a como estava. Hora 0-23; -1 desliga.
NIGHTLY_SWEEP_HOUR=1
# Buscas com texto livre ("Buscar nas lojas" do filtro de texto) por pessoa por hora
TEXT_SEARCHES_PER_HOUR=20
SEARCHES_PER_IP=3
# Telas de resultado abertas recebendo novidades ao mesmo tempo, por pessoa (abas)
WATCHES_PER_IP=4
