# Servidor
PORT=8787
HOST=127.0.0.1

# Lojas: só para a primeira vez. Ao subir, o servidor copia estas variáveis para o banco e, dali
# em diante, a configuração das lojas é editada no admin (/admin, aba Lojas); mudar aqui não vale mais.
# O código só conhece os IDs s1, s2 e s3. Cada adapter espera um tipo de site:
#   s1  catálogo Next.js em __NEXT_DATA__, HTTP simples
#   s2  Next.js App Router (payload RSC), navegador
#   s3  HTML com cards data-tss-*, navegador
# NAME    nome exibido na tela
# URL     origem do site, sem barra no fim
# SEARCH  caminho da busca, com um marcador: {q} (fonte%20750W), {q+} (fonte+750W) ou {slug} (fonte-750w)
# CATEGORIES  caminho da categoria na loja, por categoria do app (opcional)
# COLOR   cor da loja na tela, "#rrggbb" entre aspas (sem aspas, o # vira comentário) (opcional).
#         Duas ou três cores separadas por vírgula viram degradê na bolinha: "#ffc300,#e30613"
# SWEEP   caminho da página de cada categoria no site, começando com / (opcional; hoje só a s1).
#         A rotina lê a categoria inteira, algumas páginas por hora, para todo produto ter histórico.
#         Confira com: pnpm scan --sweep
# Loja sem NAME, URL ou SEARCH fica desligada.
STORE_S1_NAME=Loja 1
STORE_S1_URL=https://www.loja1.example
STORE_S1_SEARCH=/busca/{slug}
STORE_S1_COLOR="#10b981"
STORE_S1_SWEEP=psu:/hardware/fontes,motherboard:/hardware/placas-mae,cpu:/hardware/processadores,gpu:/hardware/placa-de-video,ram:/hardware/memoria-ram,ssd:/hardware/ssd,cooler:/hardware/coolers,case:/perifericos/gabinetes
STORE_S1_CATEGORIES=psu:hardware/fontes,motherboard:hardware/placas-mae,cpu:hardware/processadores,gpu:hardware/placa de video (vga)/placa de video,ram:hardware/memoria ram,ssd:hardware/ssd,cooler:hardware/coolers,case:perifericos/gabinetes

STORE_S2_NAME=Loja 2
STORE_S2_URL=https://www.loja2.example
STORE_S2_SEARCH=/search?q={q}
STORE_S2_COLOR="#8b5cf6"
STORE_S2_CATEGORIES=psu:hardware/fonte,motherboard:hardware/placa-mae,cpu:hardware/processadores

STORE_S3_NAME=Loja 3
STORE_S3_URL=https://www.loja3.example
STORE_S3_SEARCH=/busca?str={q+}
STORE_S3_COLOR="#f59e0b"
# Navegador (lojas s2 e s3), sempre em sessão anônima (nada salvo em disco).
# chrome = Google Chrome instalado. Vazio = Chromium do Playwright.
BROWSER_CHANNEL=chrome
# Headless é barrado pela proteção anti-bot. Em Linux sem tela, use xvfb-run.
BROWSER_HEADLESS=false
# Janela do Chrome fora da área visível (o usuário não vê). false = mostra a janela.
BROWSER_HIDE_WINDOW=true
# Segundos esperando alguém resolver uma verificação interativa na janela do Chrome
# NA MÁQUINA DO SERVIDOR (o usuário final não vê essa janela). 0 = não espera.
MANUAL_CHALLENGE_WAIT_S=0

# Coleta
PAGE_DELAY_MIN_MS=5000
PAGE_DELAY_MAX_MS=12000
MAX_PAGES_PER_HOUR=30
MAX_PAGES_S1=1
MAX_PAGES_S2=1

# Pasta de dados locais: banco de preços e debug (padrão: ./data na raiz).
# DATA_DIR=

# Banco SQLite: anúncios, histórico de preço e montagens compartilhadas (padrão: <DATA_DIR>/upgradezin.db).
# DB_PATH=

# Admin em /admin (usuário e senha fixos). Sem os dois, ou com senha de menos de 10 caracteres, fica desligado.
# ADMIN_USER=
# ADMIN_PASSWORD=
# Duração da sessão (horas); reiniciar o servidor também desloga
ADMIN_SESSION_H=12

# Salva HTML + screenshot de falhas em data/debug/ para consertar adapters.
DEBUG_DUMPS=false

# Busca do site: mostra o banco na hora e atualiza por trás os termos coletados há mais que isto (minutos)
REVALIDATE_MIN=10
# Rotina de coleta (atualiza o banco sozinha). ROUTINE_PAGES_PER_HOUR sai do total MAX_PAGES_PER_HOUR.
# ROUTINE_ENABLED e ROUTINE_STORES valem até a rotina ser mudada no admin (aba Coleta); depois, vale o que foi salvo lá.
ROUTINE_ENABLED=true
# Lojas que a rotina coleta sozinha. Bloqueio pausa a loja (15 min, 1 h, 6 h, 24 h) e depois ela tenta de novo.
ROUTINE_STORES=s1,s2,s3
# Lojas lentas (com navegador): intervalo mínimo SLOW_MIN_GAP_S entre consultas e, até o admin mudar, modo "lento" na rotina.
ROUTINE_SLOW_STORES=s2,s3
# Modos da rotina (escolhidos por loja no admin, aba Coleta): normal = rodada a cada ROUTINE_TICK_MIN (varredura + até ROUTINE_BATCH termos);
# reduzido e lento = um termo a cada tantos minutos (+ até 20% aleatório)
ROUTINE_REDUCED_GAP_MIN=5
ROUTINE_SLOW_GAP_MIN=10
# Texto livre pesquisado: a rotina mantém o termo por estes dias depois da última busca
ROUTINE_TEXT_DAYS=7
# Mínimo entre duas consultas a uma loja lenta, da rotina ou da busca do site (segundos).
# Elas aceitam a 1ª página e bloqueiam a seguinte quando vem segundos depois.
SLOW_MIN_GAP_S=180
ROUTINE_SLOW_REFRESH_H=24
ROUTINE_REFRESH_H=12
# Varredura de categoria (lojas com STORE_Sx_SWEEP): volta completa a cada SWEEP_REFRESH_H,
# até SWEEP_PAGES_PER_HOUR páginas por hora (saem de ROUTINE_PAGES_PER_HOUR), no máximo SWEEP_MAX_PAGES por categoria
ROUTINE_SWEEP_REFRESH_H=24
ROUTINE_SWEEP_PAGES_PER_HOUR=6
ROUTINE_SWEEP_MAX_PAGES=25
ROUTINE_PAGES_PER_HOUR=12
ROUTINE_TICK_MIN=5
ROUTINE_BATCH=4
ROUTINE_RETRY_MIN=60

# Proteções quando o app fica acessível de fora (por pessoa/IP; contadores em memória)
RATE_LIMIT_PER_MIN=120
FORCE_PER_HOUR=10
FORCE_MIN_AGE_MIN=10
SHARE_PER_HOUR=20
# Fichas técnicas (página do produto, para as medidas da montagem) por pessoa por hora; guardadas por SHEET_MAX_AGE_DAYS
SHEETS_PER_HOUR=30
SHEET_MAX_AGE_DAYS=30
# Buscas com texto livre ("Buscar nas lojas" do filtro de texto) por pessoa por hora
TEXT_SEARCHES_PER_HOUR=20
SEARCHES_PER_IP=3
# Telas de resultado abertas recebendo novidades ao mesmo tempo, por pessoa (abas)
WATCHES_PER_IP=4
