{
  "manifest_version": 3,
  "name": "Upgradezin Leitor",
  "version": "1.0.0",
  "description": "Abre as buscas das lojas em abas, lê o HTML e devolve ao Upgradezin local (127.0.0.1). Sem porta de depuração.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/start*"
      ],
      "js": [
        "start.js"
      ],
      "run_at": "document_start"
    }
  ]
}
